# ==============================================================================
# TED-RDF-CONVERSION-PIPELINE — Environment File
# ==============================================================================
# Source: Installation Manual v2.3.0-rc.4 + Update Document
#
# This file is uploaded to S3 and loaded into every ECS container via the
# EnvironmentFiles task-definition property.  Copy to .env, fill in all values,
# then run:  ./upload-env.sh --bucket <bucket-name> --profile <profile>
#
# Lines starting with # are comments and are ignored by ECS.
# ==============================================================================

# --- Airflow — credentials & flags ------------------------------------------
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
_AIRFLOW_DB_UPGRADE=true
_AIRFLOW_WWW_USER_CREATE=true

# --- Airflow — user/group IDs -----------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_GID=50000
AIRFLOW_HOME=/opt/airflow
PYTHONPATH=/opt/airflow/
IS_PRIME_ENV=true

# --- Airflow — database connections ------------------------------------------
# Format: postgresql+psycopg2://<user>:<password>@<airflow-rds-endpoint>/<db>
AIRFLOW__CORE__SQL_ALCHEMY_CONN=
# Format: db+postgresql://<user>:<password>@<airflow-rds-endpoint>/<db>
AIRFLOW__CELERY__RESULT_BACKEND=
# Format: redis://:@<elasticache-endpoint>:6379/0
AIRFLOW__CELERY__BROKER_URL=

# --- Airflow — webserver secret key (min 16 random chars) --------------------
AIRFLOW__WEBSERVER__SECRET_KEY=

# --- Airflow — executor & scheduler config -----------------------------------
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__API__AUTH_BACKEND=airflow.api.auth.backend.basic_auth
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/src/dags

# --- Airflow — performance tuning -------------------------------------------
AIRFLOW__CORE__PARALLELISM=256
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=256
AIRFLOW__CORE__NON_POOLED_TASK_SLOT_COUNT=256
AIRFLOW__SCHEDULER__PARSING_PROCESSES=8
AIRFLOW__SCHEDULER__SCHEDULER_HEARTBEAT_SEC=1
AIRFLOW__SCHEDULER__MAX_DAGRUNS_PER_LOOP_TO_SCHEDULE=128
AIRFLOW__CELERY__WORKER_CONCURRENCY=24
AIRFLOW__CORE__SQL_ALCHEMY_POOL_SIZE=512
AIRFLOW__CORE__SQL_ALCHEMY_MAX_OVERFLOW=1024
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=60
AIRFLOW__SCHEDULER__TASK_QUEUED_TIMEOUT=25200

# --- Airflow — tool paths (set by init-lib container, included for completeness)
RML_MAPPER_PATH=/opt/airflow/.rmlmapper/rmlmapper.jar
XML_PROCESSOR_PATH=/opt/airflow/.saxon/saxon-he-10.9.jar
LIMES_ALIGNMENT_PATH=/opt/airflow/.limes/limes.jar

# --- Fuseki ------------------------------------------------------------------
FUSEKI_ADMIN_PASSWORD=
ADMIN_PASSWORD=${FUSEKI_ADMIN_PASSWORD}
FUSEKI_DATASET_1=
# Cloud Map DNS name for fuseki — update to match your namespace
# Example: http://fuseki.ted-sws-sandbox.local:3030
FUSEKI_ADMIN_HOST=
FUSEKI_ADMIN_USER=admin

# --- Metabase ----------------------------------------------------------------
MB_DB_TYPE=postgres
MB_DB_DBNAME=
MB_DB_PORT=5432
MB_DB_USER=
MB_DB_PASS=
MB_DB_HOST=
MB_ENCRYPTION_SECRET_KEY=

# --- DocumentDB (MongoDB-compatible) ----------------------------------------
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_DB_AGGREGATES_DATABASE_NAME=aggregates_db
# Format: mongodb://<user>:<password>@<documentdb-endpoint>:27017/?replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_DB_AUTH_URL=
MONGO_DB_LOGS_DATABASE_NAME=aggregates_db
MONGO_DB_LOGS_COLLECTION=logs
MONGO_DB_PORT=27017

# --- Mongo Express -----------------------------------------------------------
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=
ME_CONFIG_MONGODB_ADMINUSERNAME=
ME_CONFIG_MONGODB_ADMINPASSWORD=
ME_CONFIG_MONGODB_ENABLE_ADMIN=true
# DocumentDB endpoint (same as MONGO_DB_AUTH_URL host portion + query params)
ME_CONFIG_MONGODB_SERVER=

# --- Digest API --------------------------------------------------------------
ID_MANAGER_DEV_API_HOST=https://digest-api.ted-data.eu/
# Cloud Map DNS name for digest-api — update to match your namespace
# Example: http://digest-api.ted-sws-sandbox.local:8000/
ID_MANAGER_PROD_API_HOST=
ID_MANAGER_API_PORT=8000

# --- Logging -----------------------------------------------------------------
CLI_LOGGER_CONFIG_HANDLERS=ConsoleHandler
DAG_LOGGER_CONFIG_HANDLERS=MongoDBHandler,ConsoleHandler
LOGGING_TYPE=PY
LOGGER_LOGGING_HANDLER=MONGO
LOGGER_MONGO_HANDLER_BUFFER_PERIODICAL_FLUSH_TIMING=5.0

# --- TED API ----------------------------------------------------------------
TED_API_URL=https://api.ted.europa.eu/v3/notices/search

# --- GitHub artefacts --------------------------------------------------------
GITHUB_TED_SWS_ARTEFACTS_URL=https://github.com/OP-TED/ted-rdf-mapping.git
GITHUB_TED_SWS_ARTEFACTS_REPOSITORY_NAME=ted-rdf-mapping

# --- SFTP container (atmoz/sftp:debian) ---------------------------------------
SFTP_USER=admin
SFTP_PASSWORD=
SFTP_PORT=22

# --- SFTP publishing ---------------------------------------------------------
SFTP_PUBLISH_USER=
SFTP_PUBLISH_PASSWORD=
SFTP_PUBLISH_HOST=
SFTP_PUBLISH_PORT=22
SFTP_PUBLISH_PATH=/upload
SFTP_PRIVATE_KEY_BASE64=

# --- S3 publishing -----------------------------------------------------------
S3_PUBLISH_HOST=
S3_PUBLISH_USER=
S3_PUBLISH_PASSWORD=
S3_PUBLISH_REGION=
S3_PUBLISH_SECURE=1
S3_PUBLISH_SSL_VERIFY=0
S3_PUBLISH_NOTICE_RDF_BUCKET=
S3_PUBLISH_NOTICE_BUCKET=
S3_PUBLISH_ENABLED=0
