# =============================================================================
# TED-SWS Stack - Shared Application Configuration
# Non-secret values common to all environments (local, staging, prod)
# Injected into Airflow containers via env_file in override compose files
# =============================================================================

# --- MongoDB ---
MONGO_DB_AGGREGATES_DATABASE_NAME=aggregates_db
MONGO_DB_LOGS_DATABASE_NAME=aggregates_db
MONGO_DB_PORT=27017

# --- Fuseki ---
FUSEKI_ADMIN_USER=admin
FUSEKI_ADMIN_HOST=http://fuseki:3030

# --- MinIO (S3) ---
S3_PUBLISH_HOST=minio:9000
S3_PUBLISH_USER=admin
S3_PUBLISH_SECURE=false
S3_PUBLISH_SSL_VERIFY=false
S3_PUBLISH_ENABLED=true
S3_PUBLISH_NOTICE_BUCKET=notice
S3_PUBLISH_NOTICE_RDF_BUCKET=notice-rdf
S3_PUBLISH_REGION=eu-central-1

# --- SFTP ---
SFTP_PUBLISH_HOST=sftp
SFTP_PUBLISH_PORT=22
SFTP_PUBLISH_USER=sftpuser
SFTP_PUBLISH_PATH=/upload

# --- External APIs ---
TED_API_URL=https://ted.europa.eu/api/v3.0/notices/search
GITHUB_TED_SWS_ARTEFACTS_URL=https://github.com/OP-TED/ted-rdf-mapping.git
ID_MANAGER_API_HOST=https://digest-api.ted-data.eu/
ID_MANAGER_DEV_API_HOST=https://digest-api.ted-data.eu/
ID_MANAGER_PROD_API_HOST=https://digest-api.ted-data.eu/
ID_MANAGER_API_PORT=8000

# --- Logging ---
CLI_LOGGER_CONFIG_HANDLERS=ConsoleHandler
DAG_LOGGER_CONFIG_HANDLERS=MongoDBHandler,ConsoleHandler

# --- Tool paths (mounted via compose volumes) ---
RML_MAPPER_PATH=/home/airflow/.rmlmapper/rmlmapper.jar
LIMES_ALIGNMENT_PATH=/home/airflow/.limes/limes.jar
XML_PROCESSOR_PATH=/home/airflow/.saxon/saxon-he-10.9.jar
