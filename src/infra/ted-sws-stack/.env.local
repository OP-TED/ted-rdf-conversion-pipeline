# =============================================================================
# TED-SWS Stack - Local Development Passwords
# Layered on top of .env.common (which has shared non-secret configs)
# =============================================================================

# Airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_ADMIN_PASSWORD=admin

# MinIO
MINIO_ROOT_PASSWORD=adminadmin

# MongoDB
MONGO_ROOT_PASSWORD=admin

# Mongo Express
MONGO_EXPRESS_PASSWORD=admin

# Fuseki
FUSEKI_ADMIN_PASSWORD=admin

# SFTP
SFTP_PUBLISH_PASSWORD=sftppass

# Connection strings (embed local passwords)
MONGO_DB_AUTH_URL=mongodb://admin:admin@mongodb:27017/
S3_PUBLISH_PASSWORD=adminadmin
